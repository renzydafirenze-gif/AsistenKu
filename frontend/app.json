{
  "expo": {
    "name": "AsistenSiswa",
    "slug": "asistensiswa",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "asistensiswa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2E86C1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.sch.asistensiswa",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "id.sch.asistensiswa",
      "adaptiveIcon": {
        "backgroundColor": "#2E86C1"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "apiUrl": "http://192.168.1.3:4000/api/v1"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
