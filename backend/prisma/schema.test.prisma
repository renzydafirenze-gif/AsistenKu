model SchoolClass {
  id             String   @id @default(uuid())
  name           String
  gradeLevel     Int
  academicYear   String
  homeroomName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students       User[]
  dutySchedules  DutySchedule[]
  homeworks      Homework[]
  exams          ExamSchedule[]
  subjects       Subject[]

  @@unique([name, academicYear])
  @@index([academicYear])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  fullName     String
  role         String
  classId      String?
  // Sensitive columns are encrypted at the application layer with AES-256-GCM
  // (see src/lib/fieldCrypto.ts). The PostgreSQL migration additionally enables
  // pgcrypto for defence in depth on backups and ad-hoc DBA access.
  phoneEnc     String?
  addressEnc   String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  class              SchoolClass?        @relation(fields: [classId], references: [id])
  dutiesAssigned     DutySchedule[]      @relation("DutyAssignee")
  dutiesCreated      DutySchedule[]      @relation("DutyCreator")
  checklists         UniformChecklist[]
  homeworkCreated    Homework[]          @relation("HomeworkCreator")
  homeworkOwned      Homework[]          @relation("HomeworkOwner")
  submissions        HomeworkSubmission[]
  examsCreated       ExamSchedule[]      @relation("ExamCreator")
  examsPublished     ExamSchedule[]      @relation("ExamPublisher")
  subjectsTaught     Subject[]
  pushTokens         PushToken[]
  notifications      NotificationLog[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  syncChanges        SyncChange[]
  entityStates       EntityState[]
  guardianLinks      GuardianLink[]      @relation("GuardianParent")
  wardLinks          GuardianLink[]      @relation("GuardianStudent")

  @@index([role])
  @@index([classId])
}

model GuardianLink {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  relation  String   @default("PARENT")
  createdAt DateTime @default(now())

  parent  User @relation("GuardianParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("GuardianStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model DutySchedule {
  id                String    @id @default(uuid())
  classId           String
  date              DateTime
  shift             String
  assignedStudentId String
  createdById       String
  notes             String?
  completedAt       DateTime?
  completedById     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  class           SchoolClass @relation(fields: [classId], references: [id])
  assignedStudent User        @relation("DutyAssignee", fields: [assignedStudentId], references: [id])
  createdBy       User        @relation("DutyCreator", fields: [createdById], references: [id])
  notifications   NotificationLog[]

  @@index([date, shift])
  @@index([assignedStudentId, date])
  @@index([classId, date])
}

model UniformItem {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  category  String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AcademicCalendar {
  id           String   @id @default(uuid())
  date         DateTime @unique
  dayType      String
  // Comma separated UniformItem.key values permitted on that date, ordered.
  uniformItems String   @default("")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dayType])
}

model UniformChecklist {
  id        String    @id @default(uuid())
  studentId String
  date      DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   UniformChecklistItem[]

  @@unique([studentId, date])
  @@index([date])
}

model UniformChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  itemKey     String
  label       String
  checked     Boolean   @default(false)
  checkedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  checklist UniformChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, itemKey])
}

model Subject {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  classId     String?
  teacherId   String?
  resourceUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  class     SchoolClass?    @relation(fields: [classId], references: [id])
  teacher   User?           @relation(fields: [teacherId], references: [id])
  homeworks Homework[]
  exams     ExamSchedule[]

  @@index([classId])
  @@index([teacherId])
}

model Homework {
  id             String    @id @default(uuid())
  classId        String?
  subjectId      String
  ownerStudentId String?
  title          String
  description    String?
  dueDate        DateTime
  createdById    String
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  class    SchoolClass? @relation(fields: [classId], references: [id])
  subject  Subject      @relation(fields: [subjectId], references: [id])
  owner    User?        @relation("HomeworkOwner", fields: [ownerStudentId], references: [id])
  createdBy User        @relation("HomeworkCreator", fields: [createdById], references: [id])
  submissions HomeworkSubmission[]

  @@index([classId, dueDate])
  @@index([subjectId])
  @@index([ownerStudentId])
}

model HomeworkSubmission {
  id          String         @id @default(uuid())
  homeworkId  String
  studentId   String
  status      String @default("PENDING")
  submittedAt DateTime?
  isLate      Boolean        @default(false)
  grade       Int?
  feedback    String?
  gradedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId, status])
}

model ExamSchedule {
  id            String    @id @default(uuid())
  classId       String
  subjectId     String
  title         String
  examDate      DateTime
  startTime     String
  endTime       String
  room          String?
  createdById   String
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  class       SchoolClass @relation(fields: [classId], references: [id])
  subject     Subject     @relation(fields: [subjectId], references: [id])
  createdBy   User        @relation("ExamCreator", fields: [createdById], references: [id])
  publishedBy User?       @relation("ExamPublisher", fields: [publishedById], references: [id])

  @@unique([classId, subjectId, examDate, startTime])
  @@index([examDate])
  @@index([classId, examDate])
}

model PushToken {
  id         String        @id @default(uuid())
  userId     String
  token      String        @unique
  platform   String
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationLog {
  id        String             @id @default(uuid())
  userId    String
  dutyId    String?
  type      String
  dedupeKey String             @unique
  channel   String
  status    String @default("PENDING")
  attempts  Int                @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  duty DutySchedule? @relation(fields: [dutyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  metadata   String   @default("{}")
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// Offline sync journal. Each client change carries a hybrid logical clock so
// the server can merge field-by-field (LWW register with node tie-break).
model SyncChange {
  id            String         @id @default(uuid())
  userId        String
  clientId      String
  entityType    String
  entityId      String
  operation     String
  hlc           String
  lamport       Int
  payload       String         @default("{}")
  serverVersion Int?
  applied       Boolean        @default(false)
  conflicted    Boolean        @default(false)
  createdAt     DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model EntityState {
  id          String         @id @default(uuid())
  entityType  String
  entityId    String
  version     Int            @default(1)
  // JSON map of fieldName -> HLC string, used for field-level conflict resolution.
  fieldClocks String         @default("{}")
  deleted     Boolean        @default(false)
  ownerId     String
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([ownerId])
}
